# JENVERSE environment variables
# NOTE: V1 MVP is frontend-only with mock data. These are placeholders
# for the upcoming API integration phase — no values are required to run dev.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Google Gemini ---
GEMINI_API_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3100
