# JENVERSE environment variables
#
# Copy this file to `.env.local` and fill in the keys you have.
# EVERYTHING IS OPTIONAL: with no keys set, the app runs in "demo mode"
# using mock data (auth is bypassed, AI returns preview responses).
# Add a key and the matching feature switches to the real provider.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Google Gemini ---
GEMINI_API_KEY=

# --- Apify (Social Lead Scraper) ---
# Optional. Without it, the scraper returns sample comments.
# With a token it pulls real comments via Apify actors.
APIFY_TOKEN=
# Override the default actors if you prefer different ones:
APIFY_FACEBOOK_ACTOR=apify~facebook-comments-scraper
APIFY_TIKTOK_ACTOR=clockworks~tiktok-comments-scraper

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3100
